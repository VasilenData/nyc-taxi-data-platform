{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "NYC Taxi bounded analytics sandbox. Deploy only after choosing an AWS account and spend ceiling. No compute runs on stack creation.",
  "Parameters": {
    "Environment": {
      "Type": "String",
      "Default": "dev",
      "AllowedValues": [
        "dev",
        "prod"
      ]
    },
    "OperatorPrincipalArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:iam::[0-9]{12}:(user|role)/[A-Za-z0-9+=,.@_/-]+",
      "Description": "Existing named operator allowed to assume the scoped roles. Never an account-root principal."
    },
    "ReleaseId": {
      "Type": "String",
      "AllowedPattern": "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}",
      "Description": "UUID from a verified immutable serving bundle."
    },
    "PerQueryScanLimitBytes": {
      "Type": "Number",
      "Default": 104857600,
      "MinValue": 10485760,
      "MaxValue": 1073741824,
      "Description": "Per-query cutoff; not a monthly spending limit. Cancelled queries can still incur charges."
    }
  },
  "Resources": {
    "DataBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      }
    },
    "ResultsBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "expire-query-results",
              "Status": "Enabled",
              "ExpirationInDays": 7,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 7
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      }
    },
    "DataBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "DataBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "TLSRequired",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "DataBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${DataBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "RequireCreateOnlyWrites",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${DataBucket.Arn}/releases/*"
              },
              "Condition": {
                "Null": {
                  "s3:if-none-match": "true"
                },
                "Bool": {
                  "s3:ObjectCreationOperation": "true"
                }
              }
            }
          ]
        }
      }
    },
    "ResultsBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "ResultsBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "TLSRequired",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ResultsBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${ResultsBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "CatalogDatabase": {
      "Type": "AWS::Glue::Database",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseInput": {
          "Name": {
            "Fn::Sub": "taxi_${Environment}_${AWS::StackName}"
          },
          "Description": "Immutable release tables registered only after uploaded checksums and commit manifest are verified."
        }
      }
    },
    "Workgroup": {
      "Type": "AWS::Athena::WorkGroup",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-${Environment}"
        },
        "State": "ENABLED",
        "WorkGroupConfiguration": {
          "EnforceWorkGroupConfiguration": true,
          "BytesScannedCutoffPerQuery": {
            "Ref": "PerQueryScanLimitBytes"
          },
          "PublishCloudWatchMetricsEnabled": true,
          "EngineVersion": {
            "SelectedEngineVersion": "Athena engine version 3"
          },
          "ResultConfiguration": {
            "OutputLocation": {
              "Fn::Sub": "s3://${ResultsBucket}/${Environment}/"
            },
            "ExpectedBucketOwner": {
              "Ref": "AWS::AccountId"
            },
            "EncryptionConfiguration": {
              "EncryptionOption": "SSE_S3"
            }
          }
        }
      }
    },
    "PublisherRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Ref": "OperatorPrincipalArn"
                }
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "publish-one-release",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${DataBucket.Arn}/releases/${ReleaseId}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "glue:CreateTable",
                    "glue:GetTable"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:catalog"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:database/${CatalogDatabase}"
                    },
                    {
                      "Fn::Sub": [
                        "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:table/${CatalogDatabase}/release_${ReleaseToken}_mart_daily_borough",
                        {
                          "ReleaseToken": {
                            "Fn::Join": [
                              "",
                              {
                                "Fn::Split": [
                                  "-",
                                  {
                                    "Ref": "ReleaseId"
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "Fn::Sub": [
                        "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:table/${CatalogDatabase}/release_${ReleaseToken}_mart_hourly_demand",
                        {
                          "ReleaseToken": {
                            "Fn::Join": [
                              "",
                              {
                                "Fn::Split": [
                                  "-",
                                  {
                                    "Ref": "ReleaseId"
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "QueryRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Ref": "OperatorPrincipalArn"
                }
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "read-aggregate-release",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "athena:StartQueryExecution",
                    "athena:GetQueryExecution",
                    "athena:GetQueryResults",
                    "athena:StopQueryExecution",
                    "athena:GetWorkGroup"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:athena:${AWS::Region}:${AWS::AccountId}:workgroup/${Workgroup}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "${DataBucket.Arn}/releases/${ReleaseId}/tables/mart_daily_borough/*"
                    },
                    {
                      "Fn::Sub": "${DataBucket.Arn}/releases/${ReleaseId}/tables/mart_hourly_demand/*"
                    },
                    {
                      "Fn::Sub": "${DataBucket.Arn}/releases/${ReleaseId}/manifest.json"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetBucketLocation"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "DataBucket",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "ResultsBucket",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "DataBucket",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": [
                        {
                          "Fn::Sub": "releases/${ReleaseId}/tables/mart_daily_borough/*"
                        },
                        {
                          "Fn::Sub": "releases/${ReleaseId}/tables/mart_hourly_demand/*"
                        }
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ResultsBucket",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": [
                        {
                          "Fn::Sub": "${Environment}/*"
                        }
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObject",
                    "s3:AbortMultipartUpload"
                  ],
                  "Resource": {
                    "Fn::Sub": "${ResultsBucket.Arn}/${Environment}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "glue:GetDatabase",
                    "glue:GetTable",
                    "glue:GetPartitions",
                    "glue:GetPartition",
                    "glue:BatchGetPartition"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:catalog"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:database/${CatalogDatabase}"
                    },
                    {
                      "Fn::Sub": [
                        "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:table/${CatalogDatabase}/release_${ReleaseToken}_mart_daily_borough",
                        {
                          "ReleaseToken": {
                            "Fn::Join": [
                              "",
                              {
                                "Fn::Split": [
                                  "-",
                                  {
                                    "Ref": "ReleaseId"
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "Fn::Sub": [
                        "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:table/${CatalogDatabase}/release_${ReleaseToken}_mart_hourly_demand",
                        {
                          "ReleaseToken": {
                            "Fn::Join": [
                              "",
                              {
                                "Fn::Split": [
                                  "-",
                                  {
                                    "Ref": "ReleaseId"
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "DataBucket": {
      "Value": {
        "Ref": "DataBucket"
      }
    },
    "ResultsBucket": {
      "Value": {
        "Ref": "ResultsBucket"
      }
    },
    "Database": {
      "Value": {
        "Ref": "CatalogDatabase"
      }
    },
    "Workgroup": {
      "Value": {
        "Ref": "Workgroup"
      }
    },
    "PublisherRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "PublisherRole",
          "Arn"
        ]
      }
    },
    "QueryRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "QueryRole",
          "Arn"
        ]
      }
    }
  }
}
